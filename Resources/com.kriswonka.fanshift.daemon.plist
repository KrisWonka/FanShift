<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kriswonka.fanshift.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.kriswonka.fanshift.daemon</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>com.kriswonka.fanshift.daemon</key>
        <true/>
    </dict>
    <!-- 异常退出（崩溃）时由 launchd 重新拉起；重新启动时会把没交还的风扇交还系统 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardErrorPath</key>
    <string>/var/log/com.kriswonka.fanshift.daemon.log</string>
</dict>
</plist>
